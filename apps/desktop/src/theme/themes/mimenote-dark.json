{
  "id": "mimenote-dark",
  "name": "默认",
  "appearance": "dark",
  "tokens": {
    "--mn-bg": "var(--mn-brand-carbon)",
    "--mn-bg-elevated": "color-mix(in srgb, var(--mn-brand-carbon) 88%, var(--mn-brand-ink) 12%)",
    "--mn-bg-sidebar": "color-mix(in srgb, var(--mn-brand-carbon) 72%, var(--mn-brand-ink) 28%)",
    "--mn-fg": "var(--mn-brand-paper)",
    "--mn-fg-muted": "var(--mn-brand-sand)",
    "--mn-fg-subtle": "color-mix(in srgb, var(--mn-brand-sand) 88%, var(--mn-brand-carbon) 12%)",
    "--mn-border": "color-mix(in srgb, var(--mn-brand-carbon) 82%, var(--mn-brand-sand) 18%)",
    "--mn-accent": "color-mix(in srgb, var(--mn-brand-sand) 65%, var(--mn-brand-paper) 35%)",
    "--mn-accent-fg": "var(--mn-brand-carbon)",
    "--mn-hover": "color-mix(in srgb, var(--mn-brand-carbon) 84%, var(--mn-brand-sand) 16%)",
    "--mn-active": "color-mix(in srgb, var(--mn-bg-sidebar) 80%, var(--mn-brand-sand) 20%)",
    "--mn-selection": "color-mix(in srgb, var(--mn-brand-ink) 82%, var(--mn-brand-sand) 18%)",
    "--mn-editor-bg": "var(--mn-brand-carbon)",
    "--mn-editor-fg": "var(--mn-brand-paper)",
    "--mn-editor-gutter-bg": "var(--mn-brand-carbon)",
    "--mn-editor-gutter-fg": "color-mix(in srgb, var(--mn-brand-sand) 72%, var(--mn-brand-carbon) 28%)",
    "--mn-active-line": "color-mix(in srgb, var(--mn-brand-carbon) 86%, var(--mn-brand-sand) 14%)",
    "--mn-code-bg": "color-mix(in srgb, var(--mn-brand-carbon) 78%, var(--mn-brand-ink) 22%)",
    "--mn-quote-border": "color-mix(in srgb, var(--mn-brand-carbon) 60%, var(--mn-brand-sand) 40%)",
    "--mn-scrollbar": "color-mix(in srgb, var(--mn-brand-carbon) 70%, var(--mn-brand-sand) 30%)",
    "--mn-danger": "#E38B82",
    "--mn-warning": "#D4B080",
    "--mn-success": "#8AC59B",
    "--mn-heading": "var(--mn-brand-paper)",
    "--mn-link": "var(--mn-brand-sand)",
    "--mn-font-ui": "'Segoe UI', 'Microsoft YaHei', system-ui, -apple-system, sans-serif",
    "--mn-font-mono": "'Maple Mono', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Microsoft YaHei', monospace",
    "--mn-font-size-ui": "16px",
    "--mn-font-size-editor": "16px",
    "--mn-radius": "6px",
    "--mn-shadow": "0 10px 30px color-mix(in srgb, #000000 45%, transparent)"
  }
}
