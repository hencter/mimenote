{
  "id": "mimenote-paper-dark",
  "name": "纸墨",
  "appearance": "dark",
  "tokens": {
    "--mn-bg": "color-mix(in srgb, var(--mn-brand-carbon) 78%, var(--mn-brand-ink) 22%)",
    "--mn-bg-elevated": "color-mix(in srgb, var(--mn-brand-carbon) 62%, var(--mn-brand-ink) 38%)",
    "--mn-bg-sidebar": "color-mix(in srgb, var(--mn-brand-carbon) 50%, var(--mn-brand-ink) 50%)",
    "--mn-fg": "color-mix(in srgb, var(--mn-brand-paper) 82%, var(--mn-brand-carbon) 18%)",
    "--mn-fg-muted": "color-mix(in srgb, var(--mn-brand-sand) 78%, var(--mn-brand-carbon) 22%)",
    "--mn-fg-subtle": "color-mix(in srgb, var(--mn-brand-sand) 64%, var(--mn-brand-carbon) 36%)",
    "--mn-border": "color-mix(in srgb, var(--mn-brand-carbon) 72%, var(--mn-brand-sand) 28%)",
    "--mn-accent": "color-mix(in srgb, var(--mn-brand-sand) 65%, var(--mn-brand-paper) 35%)",
    "--mn-accent-fg": "var(--mn-brand-carbon)",
    "--mn-hover": "color-mix(in srgb, var(--mn-bg-elevated) 88%, var(--mn-brand-sand) 12%)",
    "--mn-active": "color-mix(in srgb, var(--mn-bg-elevated) 88%, var(--mn-brand-sand) 12%)",
    "--mn-selection": "color-mix(in srgb, var(--mn-brand-ink) 82%, var(--mn-brand-sand) 18%)",
    "--mn-editor-bg": "var(--mn-bg)",
    "--mn-editor-fg": "var(--mn-fg)",
    "--mn-editor-gutter-bg": "var(--mn-bg-elevated)",
    "--mn-editor-gutter-fg": "var(--mn-fg-subtle)",
    "--mn-active-line": "color-mix(in srgb, var(--mn-bg) 86%, var(--mn-brand-sand) 14%)",
    "--mn-code-bg": "var(--mn-bg-elevated)",
    "--mn-quote-border": "color-mix(in srgb, var(--mn-brand-carbon) 60%, var(--mn-brand-sand) 40%)",
    "--mn-scrollbar": "color-mix(in srgb, var(--mn-brand-carbon) 70%, var(--mn-brand-sand) 30%)",
    "--mn-danger": "#E38B82",
    "--mn-warning": "#D4B080",
    "--mn-success": "#8AC59B",
    "--mn-heading": "var(--mn-fg)",
    "--mn-link": "color-mix(in srgb, var(--mn-brand-sand) 84%, var(--mn-brand-carbon) 16%)",
    "--mn-callout-note": "var(--mn-link)",
    "--mn-callout-abstract": "var(--mn-fg-muted)",
    "--mn-callout-info": "var(--mn-link)",
    "--mn-callout-todo": "var(--mn-accent)",
    "--mn-callout-tip": "var(--mn-success)",
    "--mn-callout-success": "var(--mn-success)",
    "--mn-callout-question": "var(--mn-link)",
    "--mn-callout-warning": "var(--mn-warning)",
    "--mn-callout-failure": "var(--mn-danger)",
    "--mn-callout-danger": "var(--mn-danger)",
    "--mn-callout-bug": "var(--mn-danger)",
    "--mn-callout-example": "var(--mn-accent)",
    "--mn-callout-quote": "var(--mn-fg-muted)",
    "--mn-font-ui": "'Segoe UI', 'Microsoft YaHei', system-ui, -apple-system, sans-serif",
    "--mn-font-mono": "'Maple Mono', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Microsoft YaHei', monospace",
    "--mn-font-size-ui": "16px",
    "--mn-font-size-editor": "16px",
    "--mn-radius": "6px",
    "--mn-shadow": "0 10px 30px color-mix(in srgb, #000000 38%, transparent)"
  }
}
