{
  "id": "mimenote-light",
  "name": "默认",
  "appearance": "light",
  "tokens": {
    "--mn-bg": "#F8F7F4",
    "--mn-bg-elevated": "color-mix(in srgb, var(--mn-bg) 75%, var(--mn-brand-paper) 25%)",
    "--mn-bg-sidebar": "color-mix(in srgb, var(--mn-bg) 72%, var(--mn-brand-sand) 28%)",
    "--mn-fg": "var(--mn-brand-ink)",
    "--mn-fg-muted": "#6B5039",
    "--mn-fg-subtle": "#6E5A46",
    "--mn-border": "color-mix(in srgb, var(--mn-bg) 52%, var(--mn-brand-sand) 48%)",
    "--mn-accent": "var(--mn-brand-ink)",
    "--mn-accent-fg": "var(--mn-brand-paper)",
    "--mn-hover": "color-mix(in srgb, var(--mn-brand-paper) 75%, var(--mn-brand-sand) 25%)",
    "--mn-active": "color-mix(in srgb, var(--mn-brand-paper) 35%, var(--mn-brand-sand) 65%)",
    "--mn-selection": "color-mix(in srgb, var(--mn-brand-paper) 60%, var(--mn-brand-ochre) 40%)",
    "--mn-editor-bg": "#FCFBF8",
    "--mn-editor-fg": "var(--mn-brand-ink)",
    "--mn-editor-gutter-bg": "color-mix(in srgb, var(--mn-editor-bg) 88%, var(--mn-brand-sand) 12%)",
    "--mn-editor-gutter-fg": "#6E5A46",
    "--mn-active-line": "color-mix(in srgb, var(--mn-brand-paper) 30%, var(--mn-brand-sand) 70%)",
    "--mn-code-bg": "color-mix(in srgb, var(--mn-brand-paper) 70%, var(--mn-brand-sand) 30%)",
    "--mn-quote-border": "color-mix(in srgb, var(--mn-brand-ink) 24%, var(--mn-brand-sand) 76%)",
    "--mn-scrollbar": "color-mix(in srgb, var(--mn-brand-ink) 20%, var(--mn-brand-sand) 80%)",
    "--mn-danger": "#A33B32",
    "--mn-warning": "#80511D",
    "--mn-success": "#38684B",
    "--mn-heading": "var(--mn-brand-ink)",
    "--mn-link": "color-mix(in srgb, var(--mn-brand-ink) 88%, var(--mn-brand-ochre) 12%)",
    "--mn-callout-note": "var(--mn-link)",
    "--mn-callout-abstract": "var(--mn-fg-muted)",
    "--mn-callout-info": "var(--mn-link)",
    "--mn-callout-todo": "var(--mn-link)",
    "--mn-callout-tip": "var(--mn-success)",
    "--mn-callout-success": "var(--mn-success)",
    "--mn-callout-question": "var(--mn-link)",
    "--mn-callout-warning": "var(--mn-warning)",
    "--mn-callout-failure": "var(--mn-danger)",
    "--mn-callout-danger": "var(--mn-danger)",
    "--mn-callout-bug": "var(--mn-danger)",
    "--mn-callout-example": "var(--mn-link)",
    "--mn-callout-quote": "var(--mn-fg-muted)",
    "--mn-font-ui": "'Segoe UI', 'Microsoft YaHei', system-ui, -apple-system, sans-serif",
    "--mn-font-mono": "'Maple Mono', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Microsoft YaHei', monospace",
    "--mn-font-size-ui": "16px",
    "--mn-font-size-editor": "16px",
    "--mn-radius": "6px",
    "--mn-shadow": "0 10px 30px color-mix(in srgb, var(--mn-brand-carbon) 12%, transparent)"
  }
}
