{
  "id": "mimenote-paper",
  "name": "纸墨",
  "appearance": "light",
  "tokens": {
    "--mn-bg": "color-mix(in srgb, var(--mn-brand-paper) 58%, var(--mn-brand-sand) 42%)",
    "--mn-bg-elevated": "var(--mn-brand-paper)",
    "--mn-bg-sidebar": "var(--mn-brand-sand)",
    "--mn-fg": "color-mix(in srgb, var(--mn-brand-ink) 62%, var(--mn-brand-carbon) 38%)",
    "--mn-fg-muted": "#6B5039",
    "--mn-fg-subtle": "#6E5A46",
    "--mn-border": "color-mix(in srgb, var(--mn-brand-paper) 20%, var(--mn-brand-sand) 80%)",
    "--mn-accent": "#8B5E26",
    "--mn-accent-fg": "var(--mn-brand-paper)",
    "--mn-hover": "color-mix(in srgb, var(--mn-brand-paper) 75%, var(--mn-brand-sand) 25%)",
    "--mn-active": "color-mix(in srgb, var(--mn-brand-paper) 22%, var(--mn-brand-sand) 78%)",
    "--mn-selection": "color-mix(in srgb, var(--mn-brand-paper) 65%, var(--mn-brand-ochre) 35%)",
    "--mn-editor-bg": "var(--mn-brand-paper)",
    "--mn-editor-fg": "var(--mn-fg)",
    "--mn-editor-gutter-bg": "color-mix(in srgb, var(--mn-brand-paper) 70%, var(--mn-brand-sand) 30%)",
    "--mn-editor-gutter-fg": "#6E5A46",
    "--mn-active-line": "color-mix(in srgb, var(--mn-brand-paper) 22%, var(--mn-brand-sand) 78%)",
    "--mn-code-bg": "color-mix(in srgb, var(--mn-brand-paper) 45%, var(--mn-brand-sand) 55%)",
    "--mn-quote-border": "color-mix(in srgb, var(--mn-brand-sand) 75%, var(--mn-brand-ink) 25%)",
    "--mn-scrollbar": "color-mix(in srgb, var(--mn-brand-sand) 82%, var(--mn-brand-ink) 18%)",
    "--mn-danger": "#A33B32",
    "--mn-warning": "#80511D",
    "--mn-success": "#38684B",
    "--mn-heading": "var(--mn-brand-ink)",
    "--mn-link": "var(--mn-brand-ink)",
    "--mn-callout-note": "var(--mn-link)",
    "--mn-callout-abstract": "var(--mn-fg-muted)",
    "--mn-callout-info": "var(--mn-link)",
    "--mn-callout-todo": "var(--mn-link)",
    "--mn-callout-tip": "var(--mn-success)",
    "--mn-callout-success": "var(--mn-success)",
    "--mn-callout-question": "var(--mn-link)",
    "--mn-callout-warning": "var(--mn-warning)",
    "--mn-callout-failure": "var(--mn-danger)",
    "--mn-callout-danger": "var(--mn-danger)",
    "--mn-callout-bug": "var(--mn-danger)",
    "--mn-callout-example": "var(--mn-link)",
    "--mn-callout-quote": "var(--mn-fg-muted)",
    "--mn-font-ui": "'Segoe UI', 'Microsoft YaHei', system-ui, -apple-system, sans-serif",
    "--mn-font-mono": "'Maple Mono', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Microsoft YaHei', monospace",
    "--mn-font-size-ui": "16px",
    "--mn-font-size-editor": "16px",
    "--mn-radius": "6px",
    "--mn-shadow": "0 10px 30px color-mix(in srgb, var(--mn-brand-ink) 12%, transparent)"
  }
}
